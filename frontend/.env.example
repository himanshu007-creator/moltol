# MolTol frontend env — only PUBLIC_* values reach the browser. Never put secrets here.

# Use the fixture event stream instead of a live WebSocket (true until the backend lands).
PUBLIC_USE_FIXTURE=true

# Backend base URLs (unused while PUBLIC_USE_FIXTURE=true).
PUBLIC_API_BASE=
PUBLIC_WS_BASE=

# PayPal JS SDK v6 client id (sandbox). Loaded client-side only, never a secret.
PUBLIC_PAYPAL_CLIENT_ID=sb

# Build-time voice generation only (scripts/gen-voice.ts). Never used in the browser.
CARTESIA_API_KEY=

# Dev only (astro dev): product search through SerpAPI. Read by scripts/local-api.mjs on the server, never shipped.
SERPAPI_API_KEY=
