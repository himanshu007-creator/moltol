{
  "name": "moltol",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "MolTol (\u092e\u094b\u0932-\u0924\u094b\u0932) \u2014 where agents haggle and PayPal settles. Frontend.",
  "license": "MIT",
  "scripts": {
    "dev": "rm -rf node_modules/.vite .astro/cache && astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"const fs=require('fs'),p=require('path');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(d,e.name)):[p.join(d,e.name)]);for(const f of walk('dist')){if(fs.readFileSync(f).includes('sk_car_')){console.error('secret leaked into '+f);process.exit(1)}}console.log('dist secret check ok')\"",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "astro check && tsc --noEmit",
    "astro": "astro",
    "gen:voice": "node scripts/gen-voice.ts",
    "check:copy": "node scripts/check-copy.ts",
    "prebuild": "node scripts/check-copy.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.3.0",
    "@hookform/resolvers": "^3.9.1",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "astro": "^5.12.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "motion": "^12.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "three": "^0.171.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.171.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3"
  }
}
