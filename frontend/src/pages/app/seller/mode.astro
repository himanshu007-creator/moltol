---
import Base from '@/layouts/Base.astro';
import SellerModeChooser from '@/components/react/SellerModeChooser';
---

<Base title="Choose your dashboard">
  <section class="mx-auto grid w-full max-w-md gap-6 px-5 pb-32 pt-8 sm:px-8">
    <header class="grid gap-2">
      <p class="t-label">Seller</p>
      <h1 class="t-h1">How do you run your stall?</h1>
      <p class="t-lede">You can switch any time from the account menu.</p>
    </header>
    <SellerModeChooser client:load />
  </section>
</Base>
