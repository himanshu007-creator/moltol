---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/buyer/AuthForm';
---

<Base shell={false} title="Log in · MolTol">
  <section class="mx-auto grid min-h-[calc(100dvh-4rem)] max-w-6xl items-center gap-10 px-5 pb-28 pt-8 sm:px-8 lg:grid-cols-2 lg:pb-16">
    <div class="surface-accent rise hidden min-h-[30rem] flex-col justify-between p-10 lg:flex">
      <div class="grid gap-4">
        <h1 class="t-display !text-ink">Every deal, proved fair.</h1>
        <p class="max-w-md text-lg text-ink-muted">Log in to see your stall, your basket and the receipts your agents signed.</p>
      </div>
      <p class="text-sm text-ink-muted">Sandbox money only. Hackathon build.</p>
    </div>
    <div class="mx-auto grid w-full max-w-sm gap-6">
      <div class="rise lg:hidden">
        <h1 class="t-h1 mt-1">Log in</h1>
        <p class="t-lede mt-1">Every deal, proved fair.</p>
      </div>
      <div class="hidden lg:block">
        <h1 class="t-h1">Log in</h1>
      </div>
      <AuthForm client:load mode="login" />
    </div>
  </section>
</Base>
