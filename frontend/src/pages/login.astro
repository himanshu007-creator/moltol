---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/buyer/AuthForm';
---

<Base shell={false} title="Log in · MolTol">
  <section class="relative mx-auto grid min-h-[calc(100dvh-4rem)] max-w-6xl items-center gap-10 px-5 pb-28 pt-8 sm:px-8 lg:grid-cols-2 lg:pb-16">
    <div class="glow-stage rise relative hidden min-h-[30rem] flex-col justify-between overflow-hidden rounded-3xl p-10 lg:flex">
      <div class="glow-dust" />
      <div class="relative grid gap-4">
        <h1 class="t-display" data-i18n="auth.login.title" style="color: var(--glow-ink)">Every deal, proved fair.</h1>
        <p class="max-w-md text-lg" data-i18n="auth.login.lede" style="color: var(--glow-ink-muted)">Log in to see your stall, your basket and the receipts your agents signed.</p>
      </div>
      <p class="relative text-sm" data-i18n="auth.sandboxNote" style="color: var(--glow-ink-faint)">Sandbox money only. Hackathon build.</p>
    </div>
    <div class="mx-auto grid w-full max-w-sm gap-6">
      <div class="rise lg:hidden">
        <h1 class="t-h1 mt-1" data-i18n="auth.login.heading">Log in</h1>
        <p class="t-lede mt-1" data-i18n="auth.login.title">Every deal, proved fair.</p>
      </div>
      <div class="hidden lg:block">
        <h1 class="t-h1" data-i18n="auth.login.heading">Log in</h1>
      </div>
      <AuthForm client:load mode="login" />
    </div>
  </section>
</Base>
