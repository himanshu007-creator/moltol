---
import Base from '@/layouts/Base.astro';
---

<Base shell={false} title="Not found · MolTol" chrome={true}>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="text-6xl" aria-hidden="true">🛖</p>
    <h1 class="mt-6 t-h1">Gali toh bahut maze ki hai…</h1>
    <p class="mt-3 max-w-md text-ink-muted">
      This bazaar lane doesn’t exist. The best ones never made it to the map.
    </p>
    <a href="/" class="mt-8 rounded-full bg-marigold px-6 py-3 text-sm font-semibold text-[#23180a] shadow-[0_10px_24px_-12px_rgba(242,169,0,0.9)]">
      Back to the book bazaar
    </a>
  </section>
</Base>