---
import Base from '@/layouts/Base.astro';
import LanternHero from '@/components/react/LanternHero';
---

<Base title="MolTol: haggle in the open, pay in one tap" footer shell={false}>
  <script is:inline>
    // signed-in visitors go straight to the app unless they asked to stay here
    if (document.documentElement.dataset.auth === '1' && !location.search.includes('stay=1')) location.replace('/app');
  </script>

  <!-- hero: lantern field over a flat marigold wash -->
  <section class="relative isolate overflow-hidden pt-safe">
    <div class="absolute inset-x-0 top-0 -z-20 h-[32rem] bg-marigold/25 sm:h-[36rem]" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-[32rem] sm:h-[36rem]" aria-hidden="true">
      <LanternHero client:only="react" />
    </div>

    <div class="relative z-10 mx-auto grid max-w-6xl gap-8 px-5 pb-10 pt-14 sm:px-8 sm:pb-16 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <div class="rise grid gap-5 text-ink">
        <p class="t-label" data-i18n="landing.eyebrow">Hackathon build · sandbox money only</p>
        <h1 class="t-display text-balance">
          <span data-i18n="landing.title1">Haggle in the open.</span><br />
          <span data-i18n="landing.title2">Then pay in one tap.</span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-muted" data-i18n="landing.lede">Your agent and the stall's agent bargain item by item. Every deal ends with a proof that neither side was pushed past its limit.</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/signup" class="btn btn-ink !min-h-14 !px-7 text-base" data-i18n="landing.cta.start">Start haggling</a>
          <a href="/app/buy" class="btn btn-quiet !min-h-14 !px-7 text-base" data-i18n="landing.cta.browse">Browse nearby</a>
        </div>
      </div>

      <div class="rise rise-2 hidden justify-self-end lg:block" aria-hidden="true">
        <div class="drift grid gap-3 rotate-[-4deg]">
          <span class="price-tag !text-xl">₹40.00<span class="text-xs font-semibold text-ink-muted">/kg</span></span>
          <span class="price-tag ml-16 !text-lg">₹35.00<span class="text-xs font-semibold text-ink-muted">/kg</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- two doors: buyer and seller -->
  <section class="mx-auto grid max-w-6xl gap-4 px-5 pb-12 sm:px-8 md:grid-cols-2">
    <a href="/signup" class="surface-accent rise group relative overflow-hidden p-7 sm:p-9">
      <span class="t-label text-ink" data-i18n="landing.buyer.kicker">For buyers</span>
      <h2 class="t-h1 mt-2 text-ink" data-i18n="landing.buyer.title">I want to buy</h2>
      <p class="mt-2 max-w-sm text-ink" data-i18n="landing.buyer.body">Walk up to a stall, haggle the whole basket in parallel, and keep a receipt that proves the deal was fair.</p>
      <span class="btn btn-ink mt-6 w-fit"><span data-i18n="landing.buyer.cta">Find stalls</span> <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
    </a>
    <a href="/signup" class="surface-solid rise rise-2 group relative overflow-hidden p-7 sm:p-9">
      <span class="t-label text-indigo" data-i18n="landing.seller.kicker">For shopkeepers</span>
      <h2 class="t-h1 mt-2 text-ink" data-i18n="landing.seller.title">I have a stall</h2>
      <p class="mt-2 max-w-sm text-ink-muted" data-i18n="landing.seller.body">Set your lowest prices once. Your agent holds the line and sells the rest. Works with a few big buttons and your voice.</p>
      <span class="btn btn-primary mt-6 w-fit"><span data-i18n="landing.seller.cta">Open my stall</span> <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
    </a>
  </section>

  <!-- three steps -->
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8" aria-labelledby="how">
    <p class="t-label" data-i18n="landing.steps.kicker">How it works</p>
    <h2 id="how" class="t-h1 mt-2" data-i18n="landing.steps.title">Three steps, one proof</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      <li class="surface p-6">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-marigold text-lg font-bold text-ink">1</span>
        <h3 class="t-h2 mt-4" data-i18n="landing.step1.title">Pick the basket</h3>
        <p class="mt-2 text-ink-muted" data-i18n="landing.step1.body">Nearby stalls, live open or closed. Add by the kilo, the piece or the dozen.</p>
      </li>
      <li class="surface p-6">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-teal text-lg font-bold text-white">2</span>
        <h3 class="t-h2 mt-4" data-i18n="landing.step2.title">Let the agents haggle</h3>
        <p class="mt-2 text-ink-muted" data-i18n="landing.step2.body">One lane per item, running at once. Take over any lane, or accept all the current offers.</p>
      </li>
      <li class="surface p-6">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-chili text-lg font-bold text-white">3</span>
        <h3 class="t-h2 mt-4" data-i18n="landing.step3.title">Pay and verify</h3>
        <p class="mt-2 text-ink-muted" data-i18n="landing.step3.body">One approval in the sandbox wallet. Then the receipt opens and the limits are checked.</p>
      </li>
    </ol>
  </section>
</Base>
