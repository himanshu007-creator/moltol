---
import Base from '@/layouts/Base.astro';

const CRATE = ['tomato', 'onion', 'mango', 'ginger', 'carrot', 'capsicum', 'potato', 'cauliflower', 'okra', 'cabbage'];
---

<Base title="MolTol: haggle in the open, pay in one tap" footer shell={false}>
  <!-- hero -->
  <section class="relative mx-auto max-w-6xl px-5 pb-10 pt-14 sm:px-8 sm:pb-16 sm:pt-20">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="rise grid gap-5">
        <p class="t-label text-marigold" data-i18n="landing.eyebrow">Hackathon build · sandbox money only</p>
        <h1 class="t-display text-balance">
          <span data-i18n="landing.title1">Haggle in the open.</span><br />
          <span data-i18n="landing.title2">Then pay in one tap.</span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-muted" data-i18n="landing.lede">
          Your agent and the stall's agent bargain item by item. Every deal ends with a proof that neither side was pushed past its limit.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/signup" class="btn btn-primary !min-h-14 !px-7 text-base" data-i18n="landing.cta.start">Start haggling</a>
          <a href="/app/buy" class="btn btn-quiet !min-h-14 !px-7 text-base" data-i18n="landing.cta.browse">Browse nearby</a>
        </div>
        <p class="text-xs text-ink-faint" data-i18n="landing.trustLine">Real backend · sealed-limit proof on every deal · PayPal sandbox settlement</p>
      </div>

      <!-- live preview: a clean status card, not a mood piece -->
      <div class="rise rise-2">
        <div class="surface p-6 sm:p-7">
          <p class="t-label text-ink-faint" data-i18n="landing.demo.caption">Live preview</p>
          <div class="mt-6 flex items-end justify-center gap-8 py-2 sm:gap-10">
            <div class="grid justify-items-center gap-2">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-marigold text-base font-bold text-[#23180a]" aria-hidden="true">✓</span>
              <span class="text-xs font-semibold text-ink-muted" data-i18n="landing.demo.item1">Tomatoes</span>
            </div>
            <div class="grid justify-items-center gap-2">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-teal text-base font-bold text-white" aria-hidden="true">✓</span>
              <span class="text-xs font-semibold text-ink-muted" data-i18n="landing.demo.item2">Onions</span>
            </div>
            <div class="grid justify-items-center gap-2">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-indigo text-base font-bold text-white" aria-hidden="true">✓</span>
              <span class="text-xs font-semibold text-ink-muted" data-i18n="landing.demo.item3">Mangoes</span>
            </div>
          </div>
          <p class="mt-4 border-t border-chalk pt-3 text-center text-xs text-ink-faint">
            <span class="font-semibold text-teal" data-i18n="landing.demo.agreed">agreed</span> — every lane settled below list, proof attached
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="garland-divider" aria-hidden="true"></div>

  <!-- two doors -->
  <section class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-5 md:grid-cols-2">
      <a
        href="/signup?role=buyer"
        class="surface group relative overflow-hidden p-7 transition hover:shadow-[0_28px_48px_-28px_rgba(20,17,12,0.3)] sm:p-9"
        style="border-color: color-mix(in oklab, var(--color-marigold) 45%, var(--color-chalk))"
      >
        <span class="t-label text-marigold" data-i18n="landing.buyer.kicker">For buyers</span>
        <h2 class="t-h1 mt-2" data-i18n="landing.buyer.title">I want to buy</h2>
        <p class="mt-2 max-w-sm text-ink-muted" data-i18n="landing.buyer.body">Walk up to a stall, haggle the whole basket in parallel, and keep a receipt that proves the deal was fair.</p>
        <span class="btn btn-primary mt-6 w-fit"><span data-i18n="landing.buyer.cta">Find stalls</span> <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
      </a>
      <a
        href="/signup?role=seller"
        class="surface group relative overflow-hidden p-7 transition hover:shadow-[0_28px_48px_-28px_rgba(20,17,12,0.3)] sm:p-9"
        style="border-color: color-mix(in oklab, var(--color-indigo) 40%, var(--color-chalk))"
      >
        <span class="t-label text-indigo" data-i18n="landing.seller.kicker">For shopkeepers</span>
        <h2 class="t-h1 mt-2" data-i18n="landing.seller.title">I have a stall</h2>
        <p class="mt-2 max-w-sm text-ink-muted" data-i18n="landing.seller.body">Set your lowest prices once. Your agent holds the line and sells the rest. Works with a few big buttons and your voice.</p>
        <span class="btn btn-quiet mt-6 w-fit"><span data-i18n="landing.seller.cta">Open my stall</span> <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
      </a>
    </div>
  </section>

  <!-- a vendor's stall -->
  <section class="bg-mural relative px-5 py-16 sm:px-8" aria-labelledby="stall">
    <div class="mx-auto max-w-6xl">
      <p class="t-label text-marigold" data-i18n="landing.stall.kicker">At the stall</p>
      <h2 id="stall" class="t-h1 mt-2" data-i18n="landing.stall.title">Every stall has a floor.</h2>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-muted" data-i18n="landing.stall.body">
        Every buyer has a limit. Neither side sees the other's — until the deal is done.
      </p>
      <ul class="mt-8 flex flex-wrap items-end justify-center gap-3 rounded-[2rem] border-2 border-dashed border-chalk-strong bg-paper-2/70 p-6" aria-hidden="true">
        {CRATE.map((v, i) => (
          <li class:list={['drift', i % 2 === 0 ? 'drift' : 'drift-slow']}>
            <img src={`/vegetables/${v}.svg`} alt="" class="h-12 w-12 sm:h-14 sm:w-14" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- the mandi math: a concrete day, both sides of the deal -->
  <section class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8" aria-labelledby="math">
    <p class="t-label text-chili" data-i18n="landing.math.kicker">The mandi math</p>
    <h2 id="math" class="t-h1 mt-2" data-i18n="landing.math.title">One price for everyone leaves money on the table — for both sides.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-muted" data-i18n="landing.math.body">
      A potato stall opens at ₹40/kg. By afternoon it's ₹35 for whoever haggles. By evening, ₹30 just to move stock. By night, ₹25 — and whatever's left gets dusted off, unsold. Same potatoes, same buyers, just priced by the clock instead of by the person.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="surface p-6" style="border-color: color-mix(in oklab, var(--color-marigold) 45%, var(--color-chalk))">
        <p class="t-label text-marigold" data-i18n="landing.math.vendor.title">A 1,000 kg stall, one day</p>
        <dl class="mt-4 grid gap-3 text-sm">
          <div class="flex items-center justify-between gap-3 border-b border-dashed border-chalk pb-3">
            <dt class="text-ink-muted" data-i18n="landing.math.vendor.old">Blanket time-of-day pricing</dt>
            <dd class="t-num text-right font-semibold text-ink-faint" data-i18n="landing.math.vendor.oldStat">₹29,650 · ₹29.65/kg avg · 50 kg unsold</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-ink" data-i18n="landing.math.vendor.new">Every buyer haggled, individually</dt>
            <dd class="t-num text-right font-bold text-ink" data-i18n="landing.math.vendor.newStat">₹34,155 · ₹34.15/kg avg · ~10 kg unsold</dd>
          </div>
        </dl>
        <p class="price-tag mt-5" data-i18n="landing.math.vendor.gain">+₹4,505 a day · +15% revenue, same stock</p>
        <p class="mt-3 text-xs text-ink-faint" data-i18n="landing.math.vendor.scale">At 26 selling days a month, that's over ₹1.1 lakh more — without buying or selling a single extra kilo.</p>
      </div>

      <div class="surface p-6" style="border-color: color-mix(in oklab, var(--color-teal) 45%, var(--color-chalk))">
        <p class="t-label text-teal" data-i18n="landing.math.buyer.title">A ₹500 basket, every trip</p>
        <dl class="mt-4 grid gap-3 text-sm">
          <div class="flex items-center justify-between gap-3 border-b border-dashed border-chalk pb-3">
            <dt class="text-ink-muted" data-i18n="landing.math.buyer.old">Pay the sticker price</dt>
            <dd class="t-num text-right font-semibold text-ink-faint" data-i18n="landing.math.buyer.oldStat">₹500 · no time or nerve to haggle</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-ink" data-i18n="landing.math.buyer.new">Agents haggle every item, in parallel</dt>
            <dd class="t-num text-right font-bold text-ink" data-i18n="landing.math.buyer.newStat">~₹410 · done in a couple of minutes</dd>
          </div>
        </dl>
        <p class="price-tag mt-5" data-i18n="landing.math.buyer.gain">Save ~₹90 a trip, no awkward back-and-forth</p>
        <p class="mt-3 text-xs text-ink-faint" data-i18n="landing.math.buyer.scale">Shop three times a week and that's over ₹1,000 a month back in your pocket.</p>
      </div>
    </div>

    <p class="mt-5 text-xs text-ink-faint" data-i18n="landing.math.footnote">Illustrative, based on a typical mandi's end-of-day pricing pattern — not a guaranteed return.</p>
  </section>

  <!-- proof of fair deal -->
  <section class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8" aria-labelledby="proof">
    <p class="t-label text-teal" data-i18n="landing.proof.kicker">Under every deal</p>
    <h2 id="proof" class="t-h1 mt-2" data-i18n="landing.proof.title">Proof of Fair Deal</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-muted" data-i18n="landing.proof.body">
      Before anyone commits, both limits are sealed. After the deal, they are revealed and checked — so "fair" is something you can verify, not just something you were told.
    </p>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      <li class="ticket-edge surface p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-marigold/15 text-lg text-marigold" aria-hidden="true">🔒</span>
        <h3 class="t-h2 mt-4 text-lg" data-i18n="landing.proof.sealed">Sealed</h3>
        <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.proof.sealedBody">Your limit and the stall’s floor are locked in before haggling starts.</p>
      </li>
      <li class="ticket-edge surface p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-teal/15 text-lg text-teal" aria-hidden="true">🔓</span>
        <h3 class="t-h2 mt-4 text-lg" data-i18n="landing.proof.revealed">Revealed</h3>
        <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.proof.revealedBody">The moment you agree, both sealed numbers are opened.</p>
      </li>
      <li class="ticket-edge surface p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo/15 text-lg text-indigo" aria-hidden="true">✅</span>
        <h3 class="t-h2 mt-4 text-lg" data-i18n="landing.proof.verified">Verified</h3>
        <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.proof.verifiedBody">The app checks the price never crossed either limit.</p>
      </li>
    </ol>
  </section>

  <!-- three steps, as a timeline -->
  <section class="relative mx-auto max-w-6xl px-5 pb-16 sm:px-8" aria-labelledby="how">
    <p class="t-label text-marigold" data-i18n="landing.steps.kicker">How it works</p>
    <h2 id="how" class="t-h1 mt-2" data-i18n="landing.steps.title">Three steps, one proof</h2>
    <div class="relative mt-10">
      <div class="pointer-events-none absolute inset-x-4 top-[1.125rem] hidden h-px md:block" style="background: linear-gradient(90deg, var(--color-marigold), var(--color-teal), var(--color-indigo))"></div>
      <div class="pointer-events-none absolute left-2 top-5 bottom-5 w-px md:hidden" style="background: linear-gradient(180deg, var(--color-marigold), var(--color-teal), var(--color-indigo))"></div>
      <ol class="relative grid gap-10 sm:pl-2 md:grid-cols-3 md:gap-6">
        <li class="relative pl-10 md:pl-0">
          <span class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full bg-marigold text-sm font-bold text-[#23180a] md:static md:mb-4">1</span>
          <h3 class="t-h2 text-lg" data-i18n="landing.step1.title">Pick the basket</h3>
          <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.step1.body">Nearby stalls, live open or closed. Add by the kilo, the piece or the dozen.</p>
        </li>
        <li class="relative pl-10 md:pl-0">
          <span class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full bg-teal text-sm font-bold text-white md:static md:mb-4">2</span>
          <h3 class="t-h2 text-lg" data-i18n="landing.step2.title">Let the agents haggle</h3>
          <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.step2.body">One lane per item, running at once. Take over any lane, or accept all the current offers.</p>
        </li>
        <li class="relative pl-10 md:pl-0">
          <span class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full bg-indigo text-sm font-bold text-white md:static md:mb-4">3</span>
          <h3 class="t-h2 text-lg" data-i18n="landing.step3.title">Pay and verify</h3>
          <p class="mt-2 text-sm text-ink-faint" data-i18n="landing.step3.body">One approval in the sandbox wallet. Then the receipt opens and the limits are checked.</p>
        </li>
      </ol>
    </div>
  </section>

  <div class="garland-divider" aria-hidden="true"></div>

  <!-- closing CTA: clean and confident, no theatrics -->
  <section class="relative px-5 py-16 sm:px-8">
    <div class="surface-accent mx-auto grid max-w-4xl justify-items-center gap-4 p-10 text-center sm:p-14">
      <p class="t-label !text-[#5b3200]" data-i18n="landing.departure.kicker">Deal done</p>
      <h2 class="t-h1 !text-[#23180a]" data-i18n="landing.departure.title">Pay, and drive off</h2>
      <p class="max-w-xl text-lg !text-[#3d2a0c]" data-i18n="landing.departure.body">One tap settles it. Your receipt prints itself, proof and all.</p>
      <a href="/signup" class="btn btn-ink !min-h-14 !px-8 text-base" data-i18n="landing.departure.cta">Start haggling</a>
    </div>
  </section>
</Base>
