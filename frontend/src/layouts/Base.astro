---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/astro/Header.astro';
import Footer from '@/components/astro/Footer.astro';
import Shell from '@/components/Shell.tsx';

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
  /** the landing page only */
  footer?: boolean;
  /** the product shell (role switch, nav). Off on landing, login and signup. */
  shell?: boolean;
}
const {
  title = 'MolTol — where agents haggle and PayPal settles',
  description = 'A two-sided bazaar where AI agents haggle in real time and PayPal settles. Sealed limits, Proof of Fair Deal, real sandbox settlement.',
  chrome = true,
  footer = false,
  shell = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=5"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF3E4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14162B" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MolTol" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&family=JetBrains+Mono:wght@400..700&display=swap"
    />
    <title>{title}</title>
    <slot name="head" />

    <ClientRouter />

    {/* Set the theme before first paint so there is never a flash. */}
    <script is:inline define:vars={{ requiresAuth: shell }}>
      (function () {
        try {
          var t = localStorage.getItem('moltol-theme');
          if (t !== 'light' && t !== 'dark') {
            t = 'light';
          }
          document.documentElement.dataset.theme = t;
          var l = localStorage.getItem('moltol-locale');
          if (l) document.documentElement.lang = l;
          // the full session lives in IndexedDB; this tiny hint is mirrored to
          // localStorage so auth state is known before IndexedDB can resolve
          var hint = localStorage.getItem('moltol-auth-hint');
          var loggedIn = !!(hint && JSON.parse(hint).loggedIn);
          if (loggedIn) {
            document.documentElement.dataset.auth = '1';
          }
          // Every /app/* page (shell=true) needs a real session. A reload, a
          // bookmark, the back button after logout, or a true first visit
          // landing straight on an /app/* URL must not show stale content
          // with no nav — redirect to login before paint in every case.
          if (requiresAuth && !loggedIn) {
            location.replace('/login');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-dvh bg-paper text-ink antialiased">
    {/* golden-hour atmosphere: sunset wash, rangoli and grain, all behind content */}
        <div aria-hidden="true" class="bg-rangoli pointer-events-none fixed inset-0 -z-20 opacity-[0.28] dark:opacity-[0.16]"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    {chrome && <Header shell={shell} />}
    {shell && <Shell client:load />}
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    {chrome && footer && <Footer />}

    {/* page-to-page splash: the scale tips, a bazaar line plays, gone before you notice the wait */}
    <div id="nav-splash" aria-hidden="true" class="nav-splash">
      <div class="nav-splash-card">
        <img src="/icon.svg" alt="" width="56" height="56" class="nav-splash-scale" />
        <p id="nav-splash-line" class="nav-splash-line"></p>
      </div>
    </div>

    <script>
      import { usePrefs } from '@/stores/prefs';
      const sync = () => usePrefs.getState().sync();
      sync();
      document.addEventListener('astro:page-load', sync);
    </script>

    <script>
      const LINES = [
        'Weighing today’s prices…',
        'Agents are haggling…',
        'Finding the fair price…',
        'Sealing the limits…',
        'Walking to the next stall…',
      ];
      const MIN_VISIBLE_MS = 420;
      const el = document.getElementById('nav-splash');
      const lineEl = document.getElementById('nav-splash-line');
      let shownAt = 0;
      let hideTimer: ReturnType<typeof setTimeout> | null = null;

      function show() {
        if (!el || !lineEl) return;
        if (hideTimer) clearTimeout(hideTimer);
        lineEl.textContent = LINES[Math.floor(Math.random() * LINES.length)] ?? '';
        shownAt = performance.now();
        el.classList.add('is-visible');
      }
      function hide() {
        if (!el) return;
        const elapsed = performance.now() - shownAt;
        const wait = Math.max(0, MIN_VISIBLE_MS - elapsed);
        hideTimer = setTimeout(() => el.classList.remove('is-visible'), wait);
      }

      document.addEventListener('astro:before-preparation', show);
      document.addEventListener('astro:after-swap', hide);
      // safety net: never leave the splash stuck up if a transition errors out
      document.addEventListener('astro:page-load', hide);
    </script>
  </body>
</html>
