# Copy to terraform.tfvars and fill in. Never commit real values.
# AWS credentials come from the standard chain: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_PROFILE, or ~/.aws/credentials.
# The stack is deployed from a local source tarball (no git repo needed).

repo_subdir = "."   # compose stack lives at the repo root

aws_region   = "ap-southeast-2"   # Sydney (the only region the Free-plan SCP permits)
instance_type = "t3.small"         # free-tier-eligible minimum; 2 vCPU / 2GB
instance_name = "moltol"
root_volume_gb = 30

# Scale the api tier up/down by changing this.
api_replicas    = 1
worker_replicas = 1

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH down to your own IP in production.
ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]

enable_https = true

# ---- App integrations (optional; leave empty for offline fallbacks) ----------
# paypal_env           = "sandbox"
# paypal_client_id     = ""
# paypal_client_secret = ""
# paypal_webhook_id    = ""
# llm_base_url         = ""
# llm_api_key          = ""
# llm_model            = ""
# channel3_api_key     = ""
# seal_key             = ""  # openssl rand -hex 32
