# ---- Copy to .env for local docker compose ----------------------------------
#   docker compose up -d --scale api=3

NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
IMAGE_TAG=dev

# Public URL the browser and PayPal webhooks reach (https on 443).
# Locally you need a tunnel; on the instance Terraform sets api.<ip>.nip.io.
PUBLIC_BASE_URL=http://localhost:8080

# Where the browser's PayPal return/cancel redirect lands — the frontend's
# own origin (the API's /return and /cancel routes forward here).
FRONTEND_BASE_URL=http://localhost:4321

# ---- Postgres -----------------------------------------------------------------
POSTGRES_USER=moltol
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=moltol

# ---- Caddy --------------------------------------------------------------------
# ":80" = plain HTTP. Set to api.<instance-ip>.nip.io for automatic HTTPS.
SITE_ADDRESS=:80

# ---- Only needed when running api/worker directly (pnpm dev) ------------------
DATABASE_URL=postgres://moltol:change-me-in-prod@localhost:5432/moltol
REDIS_URL=redis://localhost:6379

# ---- PayPal (sandbox) ---------------------------------------------------------
# Without PayPal keys checkout uses an offline mock that "pays" without money.
# Production (NODE_ENV=production) refuses that unless you opt in — fine for a
# keyless local demo, set it to false (or add keys) for anything public.
ALLOW_MOCK_PAYMENTS=true
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app; simulated webhooks self-verify against this.
PAYPAL_WEBHOOK_ID=

# ---- LLM (OpenAI-compatible, optional) ---------------------------------------
# When unset the engine uses a deterministic canned narrator and never calls out.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Market comps (Channel3 / SerpAPI, optional) ------------------------------
# Tried in order: Channel3, then SerpAPI. When both are unset (or both fail) the
# market package serves a deterministic seeded dataset.
CHANNEL3_API_KEY=
SERPAPI_API_KEY=

# ---- Proof-of-Fair-Deal sealing key (32-byte hex, optional) -------------------
# Used to AEAD-seal sealed limits at rest. Generate: openssl rand -hex 32
SEAL_KEY=

# ---- Auth: email OTP delivery (Brevo SMTP relay, free tier: 300/day) ---------
# https://app.brevo.com/settings/keys/smtp — verify a sender (no domain needed),
# then use its SMTP login + generated key here. Without SMTP_USER/PASSWORD, OTP
# codes are logged, not emailed.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MolTol <your-verified-sender@example.com>

# ---- Auth: session signing (REQUIRED in production) ---------------------------
# The API refuses to start with NODE_ENV=production unless this is a private
# value of 32+ characters. Generate: openssl rand -hex 32
JWT_SECRET=
# Session lifetime (logout revokes one session; a password reset revokes all).
JWT_TTL=7d

# ---- Bazaar ------------------------------------------------------------------
# Currency new shops price in. PayPal settles INR only for India-domiciled
# merchant accounts — see README "PayPal and INR" before a live PayPal demo.
DEFAULT_CURRENCY=INR
# PayPal does not support INR, so checkout converts the deal total into this
# currency for the charge (see README "PayPal and INR"). The deal stays in INR.
PAYPAL_SETTLEMENT_CURRENCY=USD
# INR -> USD rate, applied to minor units (~₹83.33 = $1). Set the current rate
# before a live run; it is a configured constant, not a live quote.
FX_USD_PER_INR=0.012
# Pause between agent turns (worker), so a haggle streams at a watchable pace
# and a buyer can take a lane over mid-haggle. 0 = instant.
TURN_DELAY_MS=900
WORKER_CONCURRENCY=32

# ---- Abuse limits ------------------------------------------------------------
# Requests/minute per client IP (auth endpoints: 10/min; baskets: 20/min/user).
RATE_LIMIT_PER_MIN=300
# Peers allowed to set X-Forwarded-For (Caddy on the compose network).
TRUST_PROXY=loopback,uniquelocal
