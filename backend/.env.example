# ---- Copy to .env for local docker compose ----------------------------------
#   docker compose up -d --scale api=3

NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
IMAGE_TAG=dev

# Public URL the browser and PayPal webhooks reach (https on 443).
# Locally you need a tunnel; on the instance Terraform sets api.<ip>.nip.io.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Postgres -----------------------------------------------------------------
POSTGRES_USER=moltol
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=moltol

# ---- Caddy --------------------------------------------------------------------
# ":80" = plain HTTP. Set to api.<instance-ip>.nip.io for automatic HTTPS.
SITE_ADDRESS=:80

# ---- Only needed when running api/worker directly (pnpm dev) ------------------
DATABASE_URL=postgres://moltol:change-me-in-prod@localhost:5432/moltol
REDIS_URL=redis://localhost:6379

# ---- PayPal (sandbox) ---------------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app; simulated webhooks self-verify against this.
PAYPAL_WEBHOOK_ID=

# ---- LLM (OpenAI-compatible, optional) ---------------------------------------
# When unset the engine uses a deterministic canned narrator and never calls out.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Market comps (Channel3, optional) ---------------------------------------
# When unset the market package serves a deterministic seeded dataset.
CHANNEL3_API_KEY=

# ---- Proof-of-Fair-Deal sealing key (32-byte hex, optional) -------------------
# Used to AEAD-seal sealed limits at rest. Generate: openssl rand -hex 32
SEAL_KEY=

# ---- Auth: email OTP delivery (Brevo SMTP relay, free tier: 300/day) ---------
# https://app.brevo.com/settings/keys/smtp — verify a sender (no domain needed),
# then use its SMTP login + generated key here. Without SMTP_USER/PASSWORD, OTP
# codes are logged, not emailed.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MolTol <your-verified-sender@example.com>

# ---- Auth: session signing (32-byte hex, required in production) -------------
# Generate: openssl rand -hex 32
JWT_SECRET=
