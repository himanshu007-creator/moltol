# Copy to terraform.tfvars and fill in. Never commit real values.

do_token   = "dop_v1_xxx"                              # or export DIGITALOCEAN_TOKEN
repo_url   = "https://github.com/your-org/moltol.git"  # must be public for the VM to clone
git_ref    = "main"
repo_subdir = "backend"                                 # compose stack lives here
region     = "nyc3"
droplet_size = "s-1vcpu-1gb"

# Scale the api tier up/down by changing this.
api_replicas    = 2
worker_replicas = 1

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH down to your own IP in production.
ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]

enable_https = true
