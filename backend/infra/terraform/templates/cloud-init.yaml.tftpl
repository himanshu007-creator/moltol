#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  # docker compose v2 ships with the get.docker.com install; verify.
  - docker compose version
  - mkdir -p /opt/moltol
  - touch /opt/moltol/.cloud-init-done
