NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=*
IMAGE_TAG=${image_tag}

POSTGRES_USER=${postgres_user}
POSTGRES_PASSWORD=${postgres_password}
POSTGRES_DB=${postgres_db}

# Caddy entrypoint. nip.io resolves this hostname to the instance IP.
SITE_ADDRESS=${site_address}

# Public URL the browser and PayPal webhooks reach.
PUBLIC_BASE_URL=${public_base_url}

# ---- PayPal (sandbox or live) ------------------------------------------------
PAYPAL_ENV=${paypal_env}
PAYPAL_CLIENT_ID=${paypal_client_id}
PAYPAL_CLIENT_SECRET=${paypal_client_secret}
PAYPAL_WEBHOOK_ID=${paypal_webhook_id}
ALLOW_MOCK_PAYMENTS=${allow_mock_payments}

# ---- LLM (OpenAI-compatible, optional) ---------------------------------------
LLM_BASE_URL=${llm_base_url}
LLM_API_KEY=${llm_api_key}
LLM_MODEL=${llm_model}

# ---- Market comps (Channel3, optional) ---------------------------------------
CHANNEL3_API_KEY=${channel3_api_key}

# ---- Proof-of-Fair-Deal sealing key (32-byte hex, optional) -------------------
SEAL_KEY=${seal_key}

# ---- Auth ----------------------------------------------------------------------
# Generated by Terraform (random_password.jwt); required in production.
JWT_SECRET=${jwt_secret}
SMTP_USER=${smtp_user}
SMTP_PASSWORD=${smtp_password}
EMAIL_FROM=${email_from}
