#!/usr/bin/env bash
# Runs on the EC2 instance. Terraform already extracted the source tarball into
# REPO_DIR; this builds the images and starts the stack. api/worker replica
# counts come from Terraform variables.
set -euo pipefail

REPO_DIR=/home/ubuntu/moltol/repo
ENV_FILE=/home/ubuntu/moltol/.env
SUBDIR="${repo_subdir}"
API_REPLICAS=${api_replicas}
WORKER_REPLICAS=${worker_replicas}

cd "$REPO_DIR/$SUBDIR"

# Compose v5 resolves --env-file relative to the project dir; ship .env there
# so interpolation always works regardless of version.
cp "$ENV_FILE" "$REPO_DIR/$SUBDIR/.env"

echo "[moltol] building images (subdir=$SUBDIR api=$API_REPLICAS worker=$WORKER_REPLICAS)"
docker compose build

echo "[moltol] starting stack"
docker compose up -d --remove-orphans \
  --scale api="$API_REPLICAS" \
  --scale worker="$WORKER_REPLICAS"

echo "[moltol] pruning dangling images"
docker image prune -f >/dev/null 2>&1 || true

echo "[moltol] status"
docker compose ps
echo "[moltol] deploy complete"