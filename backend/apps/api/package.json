{
  "name": "@moltol/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(api) lint via root prettier\"",
    "test": "echo \"(api) covered by engine/paypal unit tests\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@moltol/config": "workspace:*",
    "@moltol/contracts": "workspace:*",
    "@moltol/engine": "workspace:*",
    "@moltol/llm": "workspace:*",
    "@moltol/market": "workspace:*",
    "@moltol/paypal": "workspace:*",
    "@moltol/policy": "workspace:*",
    "@moltol/store": "workspace:*",
    "bullmq": "^5.34.3",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
