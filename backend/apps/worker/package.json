{
  "name": "@moltol/worker",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(worker) lint via root prettier\"",
    "test": "echo \"(worker) covered by engine unit tests\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moltol/config": "workspace:*",
    "@moltol/contracts": "workspace:*",
    "@moltol/engine": "workspace:*",
    "@moltol/llm": "workspace:*",
    "@moltol/market": "workspace:*",
    "@moltol/store": "workspace:*",
    "bullmq": "^5.34.3",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
